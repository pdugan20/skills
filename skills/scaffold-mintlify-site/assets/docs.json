{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "maple",
  "name": "<PROJECT_NAME>",
  "description": "<One sentence: what it does, leading with the differentiator.>",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "feedback": {
    "thumbsRating": true
  },
  "appearance": {
    "default": "system"
  },
  "colors": {
    "primary": "<#BRAND>",
    "light": "<#BRAND_LIGHT>",
    "dark": "<#BRAND_DARK>"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/<OWNER>/<PROJECT>"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/<OWNER>/<PROJECT>"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["introduction", "quickstart", "requirements"]
          },
          {
            "group": "Everyday use",
            "pages": ["guides/<core-task-1>", "guides/<core-task-2>"]
          },
          {
            "group": "Integrations",
            "pages": ["guides/<integration-1>"]
          },
          {
            "group": "Claude (MCP)",
            "pages": ["concepts/mcp-server", "guides/remote-mcp"]
          },
          {
            "group": "Concepts",
            "pages": ["concepts/architecture", "concepts/design"]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting", "changelog"]
          }
        ]
      },
      {
        "tab": "Reference",
        "pages": [
          {
            "group": "CLI",
            "pages": ["reference/cli"]
          },
          {
            "group": "MCP",
            "pages": ["reference/mcp-tools"]
          },
          "reference/configuration"
        ]
      }
    ]
  }
}
