{
  "name": "patrick-skills",
  "version": "2.4.0",
  "private": true,
  "description": "Portable design, UI analysis, development, and documentation skills for Agent Skills clients.",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.{json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{json,yaml,yml}\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "skills:list": "DISABLE_TELEMETRY=1 npx --yes skills@1.5.21 add . --list",
    "check:skills-sh": "python3 scripts/check_skills_sh.py",
    "refresh:skills-sh": "node scripts/refresh_skills_sh.mjs",
    "test": "python3 -B -m unittest discover -s scripts -p 'test_*.py' -v",
    "test:installation": "node scripts/test_installation.mjs",
    "validate": "python3 scripts/validate_repository.py",
    "validate:claude-plugin": "claude plugin validate . --strict",
    "validate:external": "skill-validator check --strict --allow-dirs=agents,evals skills/",
    "verify": "npm run test && npm run test:installation && npm run validate && npm run validate:claude-plugin && npm run lint:markdown && npm run format:check && npm run skills:list"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@11.5.2"
}
